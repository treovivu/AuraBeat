# Copy to .env.local and restart `npm run dev`.

# Approved performance video for NEFFEX – "Grateful". Put the file in public/ and reference it
# from the site root, or use a URL you are licensed to stream.
# VITE_PERFORMANCE_VIDEO_URL=/media/grateful.mp4

# Force a performance: grateful | neon-tide.
# Unset: Grateful when a video is configured, otherwise the Neon Tide mock.
# VITE_PERFORMANCE=grateful
